# ---------------------------------------------------------------------------
# All-in-one image: the strix orchestrator (code + Python deps) layered on the
# pentest sandbox toolchain, so ONE image is all a host needs:
#
#   - started manually (`docker run`), its entrypoint runs `strix` and the
#     image acts as the orchestrator;
#   - spawned per scan by that orchestrator (manifest env STRIX_SANDBOX_ROLE=1),
#     it delegates to the sandbox bootstrap and acts as the sandbox.
#
# Build (one image, one command):
#   scripts/docker-allinone.sh [tag] [sandbox-base]
# or directly:
#   docker build -f containers/Dockerfile.allinone -t strix-allinone:dev .
#
# Run on your own server (the socket lets strix spawn sandbox containers on
# the host daemon; those sandboxes reuse this very image, nothing is pulled):
#   docker run --rm --network host \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -e STRIX_LLM='openrouter/z-ai/glm-5.3' -e LLM_API_KEY='...' \
#     -v "$PWD/strix_runs:/workspace/strix_runs" \
#     strix-allinone:dev -n -t https://example.com --scan-mode quick
# ---------------------------------------------------------------------------

# The published sandbox image by default; point SANDBOX_BASE at a locally
# built strix-sandbox:<tag> (scripts/docker.sh) to layer on your own build.
ARG SANDBOX_BASE=ghcr.io/usestrix/strix-sandbox:1.3.1
FROM ${SANDBOX_BASE}

USER root

# Install the strix orchestrator into its own venv, isolated from the sandbox
# role's /app/.venv (caido-sdk-client, jwt_tool deps). uv and golang-go both
# ship in the base image; the wheel build compiles the Go TUI sidecar. Build
# caches are redirected to /tmp and dropped in the same layer so they never
# reach the image.
COPY pyproject.toml uv.lock README.md /opt/strix-src/
COPY strix/ /opt/strix-src/strix/
COPY scripts/tui_sidecar_hook.py /opt/strix-src/scripts/tui_sidecar_hook.py
RUN UV_CACHE_DIR=/tmp/uv-cache GOCACHE=/tmp/go-build GOMODCACHE=/tmp/go-mod \
    UV_PROJECT_ENVIRONMENT=/opt/strix/.venv \
    uv sync --frozen --no-dev --no-editable --directory /opt/strix-src \
 && rm -rf /opt/strix-src /tmp/uv-cache /tmp/go-build /tmp/go-mod \
 && ln -s /opt/strix/.venv/bin/strix /usr/local/bin/strix

COPY containers/strix-entrypoint.sh /usr/local/bin/strix-entrypoint.sh
RUN chmod +x /usr/local/bin/strix-entrypoint.sh

ENV PATH="/opt/strix/.venv/bin:${PATH}"

USER pentester

# Reports and run artifacts land under the working directory; /workspace is
# the conventional mount point to keep them.
WORKDIR /workspace

ENTRYPOINT ["strix-entrypoint.sh"]
