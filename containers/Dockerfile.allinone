# ---------------------------------------------------------------------------
# All-in-one image: the strix orchestrator (code + Python deps) layered on the
# pentest sandbox toolchain, so ONE image is all a host needs:
#
#   - started manually (`docker run`), its entrypoint runs `strix` and the
#     image acts as the orchestrator;
#   - spawned per scan by that orchestrator (manifest env STRIX_SANDBOX_ROLE=1),
#     it delegates to the sandbox bootstrap and acts as the sandbox.
#
# Build (one image, one command):
#   scripts/docker-allinone.sh [tag] [sandbox-base]
# or directly:
#   docker build -f containers/Dockerfile.allinone -t strix-allinone:dev .
#
# Run on your own server (the socket lets strix spawn sandbox containers on
# the host daemon; those sandboxes reuse this very image, nothing is pulled):
#   docker run --rm --network host \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -e STRIX_LLM='openrouter/z-ai/glm-5.3' -e LLM_API_KEY='...' \
#     -v "$PWD/strix_runs:/workspace/strix_runs" \
#     strix-allinone:dev -n -t https://example.com --scan-mode quick
# ---------------------------------------------------------------------------

# The published sandbox image by default; point SANDBOX_BASE at a locally
# built strix-sandbox:<tag> (scripts/docker.sh) to layer on your own build.
ARG SANDBOX_BASE=ghcr.io/usestrix/strix-sandbox:1.3.1
FROM ${SANDBOX_BASE}

# ---------------------------------------------------------------------------
# Java security toolkit (all-in-one only; not in the published sandbox image)
# ---------------------------------------------------------------------------
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends maven fontconfig && \
    (apt-get install -y --no-install-recommends libgtk-3-0 || \
      apt-get install -y --no-install-recommends libgtk-3-0t64 || \
      echo "WARNING: GTK3 not found under either package name; MAT/SWT headless may fail") && \
    (apt-get install -y --no-install-recommends jadx || \
      echo "WARNING: jadx not in apt; install from GitHub releases manually") && \
    (apt-get install -y --no-install-recommends procyon-decompiler || \
      echo "WARNING: procyon-decompiler not in apt; CFR remains the decompiler fallback") && \
    rm -rf /var/lib/apt/lists/*

# JDK 17, pinned via Eclipse Temurin. Kali rolling no longer packages
# openjdk-17 (the apt JDK would also drift with the base image), so pull the
# current 17 GA tarball — the API resolves "latest 17" to a concrete build.
# JAVA_HOME is fixed at /opt/java-home and prepended to PATH so mvn/gradle,
# the tool wrappers, and MAT's launcher all resolve the same JDK.
RUN set -eux; \
    jdk_arch=x64; \
    if [ "$(dpkg --print-architecture)" = arm64 ]; then jdk_arch=aarch64; fi; \
    mkdir -p /opt/java-home && \
    curl -fsSL "https://api.adoptium.net/v3/binary/latest/17/ga/linux/${jdk_arch}/jdk/hotspot/normal/eclipse" \
      | tar -xz -C /opt/java-home --strip-components=1 && \
    /opt/java-home/bin/java -version
ENV JAVA_HOME=/opt/java-home
ENV PATH="/opt/java-home/bin:${PATH}"

# Kali's apt gradle lags far behind; use the official distribution.
ARG GRADLE_VERSION=8.14
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
      -o /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle && \
    rm /tmp/gradle.zip

# SpotBugs + FindSecBugs: bytecode SAST for compiled targets.
ARG SPOTBUGS_VERSION=4.8.6
ARG FINDSECBUGS_VERSION=1.13.0
RUN curl -fsSL "https://github.com/spotbugs/spotbugs/releases/download/${SPOTBUGS_VERSION}/spotbugs-${SPOTBUGS_VERSION}.zip" \
      -o /tmp/spotbugs.zip && \
    unzip -q /tmp/spotbugs.zip -d /opt && \
    ln -s "/opt/spotbugs-${SPOTBUGS_VERSION}/bin/spotbugs" /usr/local/bin/spotbugs && \
    rm /tmp/spotbugs.zip && \
    curl -fsSL "https://repo1.maven.org/maven2/com/h3xstream/findsecbugs/findsecbugs-plugin/${FINDSECBUGS_VERSION}/findsecbugs-plugin-${FINDSECBUGS_VERSION}.jar" \
      -o "/opt/spotbugs-${SPOTBUGS_VERSION}/plugin/findsecbugs-plugin.jar"

# CFR: single-jar decompiler, maven-central URL is stable.
ARG CFR_VERSION=0.152
RUN mkdir -p /opt/java-tools && \
    curl -fsSL "https://repo1.maven.org/maven2/org/benf/cfr/${CFR_VERSION}/cfr-${CFR_VERSION}.jar" \
      -o /opt/java-tools/cfr.jar && \
    printf '#!/bin/bash\nexec java -jar /opt/java-tools/cfr.jar "$@"\n' > /usr/local/bin/cfr && \
    chmod +x /usr/local/bin/cfr

# OWASP Dependency-Check (SCA). Best-effort: a failed download warns but does
# not break the build; trivy still covers dependency CVEs.
ARG DEPCHECK_VERSION=12.1.0
RUN if curl -fsSL "https://github.com/jeremylong/DependencyCheck/releases/download/v${DEPCHECK_VERSION}/dependency-check-${DEPCHECK_VERSION}.zip" \
      -o /tmp/depcheck.zip; then \
      unzip -q /tmp/depcheck.zip -d /opt && \
      ln -s "/opt/dependency-check/bin/dependency-check.sh" /usr/local/bin/dependency-check && \
      rm /tmp/depcheck.zip; \
    else \
      echo "WARNING: Dependency-Check download failed; skipping (trivy remains available)"; \
    fi

# ysoserial + marshalsec: built from source for current gadget chains. Build
# caches are dropped in the same layer. Requires maven central to be reachable
# at IMAGE BUILD time.
RUN set -eux; \
    git clone --depth 1 https://github.com/frohoff/ysoserial /tmp/ysoserial && \
    (cd /tmp/ysoserial && mvn -q -DskipTests package) && \
    { cp /tmp/ysoserial/target/ysoserial-*-all.jar /opt/java-tools/ysoserial.jar 2>/dev/null || \
      cp /tmp/ysoserial/target/ysoserial-*-jar-with-dependencies.jar /opt/java-tools/ysoserial.jar; } && \
    git clone --depth 1 https://github.com/mbechler/marshalsec /tmp/marshalsec && \
    (cd /tmp/marshalsec && mvn -q -DskipTests package) && \
    { cp /tmp/marshalsec/target/marshalsec-*-jar-with-dependencies.jar /opt/java-tools/marshalsec.jar 2>/dev/null || \
      cp /tmp/marshalsec/target/marshalsec-*-all.jar /opt/java-tools/marshalsec.jar; }; \
    rm -rf /tmp/ysoserial /tmp/marshalsec /root/.m2; \
    printf '#!/bin/bash\nexec java -jar /opt/java-tools/ysoserial.jar "$@"\n' > /usr/local/bin/ysoserial && \
    printf '#!/bin/bash\nexec java -jar /opt/java-tools/marshalsec.jar "$@"\n' > /usr/local/bin/marshalsec && \
    chmod +x /usr/local/bin/ysoserial /usr/local/bin/marshalsec

# JNDI-Exploit-Kit: best-effort (release assets on forks move around).
ARG JNDIKIT_VERSION=1.6
RUN if curl -fsSL "https://github.com/beichengzk/JNDI-Exploit-Kit/releases/download/v${JNDIKIT_VERSION}/JNDI-Exploit-Kit-${JNDIKIT_VERSION}-snAPSHOT-all.jar" \
      -o /opt/java-tools/jndi-exploit-kit.jar; then \
      printf '#!/bin/bash\nexec java -jar /opt/java-tools/jndi-exploit-kit.jar "$@"\n' > /usr/local/bin/jndi-exploit-kit && \
      chmod +x /usr/local/bin/jndi-exploit-kit; \
    else \
      echo "WARNING: JNDI-Exploit-Kit download failed; skipping"; \
    fi

# SerializationDumper: parse Java serialization streams into their class/field
# structure — the "know the classpath before picking a ysoserial chain" step.
# Small Java tool with no release artifacts, so clone and build it (the JDK
# installed above has javac/jar). CLI: -f = hex-ascii file, -r = raw bytes.
RUN git clone --depth 1 https://github.com/NickstaDB/SerializationDumper \
      /opt/java-tools/SerializationDumper && \
    cd /opt/java-tools/SerializationDumper && \
    bash build.sh >/dev/null && \
    printf '#!/bin/bash\nexec java -jar /opt/java-tools/SerializationDumper/SerializationDumper.jar "$@"\n' \
      > /usr/local/bin/serialization-dumper && \
    chmod +x /usr/local/bin/serialization-dumper

# Eclipse MAT (Memory Analyzer), headless: parse hprof heapdumps (e.g. Spring
# /actuator/heapdump) into leak-suspect reports and OQL object hunting. The
# GTK3/fontconfig stack its bundled SWT needs is installed above (chromium in
# the base image already provides most of it). Best-effort: artifacts live
# under .../mat/<ver>/rcp/ with a build timestamp embedded in the zip name
# (MemoryAnalyzer-1.17.0.20260601-linux.gtk.<arch>.zip), so scrape the
# directory listing for this architecture's artifact. ParseHeapDump.sh
# resolves its sibling MemoryAnalyzer via $0, so expose a wrapper (a plain
# symlink under /usr/local/bin would break that resolution).
ARG MAT_VERSION=1.17.0
RUN set -eux; \
    mat_arch=x86_64; \
    if [ "$(dpkg --print-architecture)" = arm64 ]; then mat_arch=aarch64; fi; \
    url_base="https://download.eclipse.org/mat/${MAT_VERSION}/rcp"; \
    mat_zip="$(curl -fsSL "${url_base}/" \
      | grep -oE "MemoryAnalyzer-[0-9.]+-linux\.gtk\.${mat_arch}\.zip" \
      | sort -u | head -1 || true)"; \
    if [ -n "$mat_zip" ]; then \
      curl -fsSL "${url_base}/${mat_zip}" -o /tmp/mat.zip && \
      unzip -q /tmp/mat.zip -d /opt && rm /tmp/mat.zip && \
      sed -i 's/-Xmx[0-9]*[gmg]/-Xmx4g/' /opt/mat/MemoryAnalyzer.ini && \
      printf '#!/bin/bash\nexec /opt/mat/ParseHeapDump.sh "$@"\n' \
        > /usr/local/bin/mat-parse-heapdump && \
      chmod +x /usr/local/bin/mat-parse-heapdump; \
    else \
      echo "WARNING: MAT artifact not found for ${mat_arch}; skipping heapdump tooling"; \
    fi

# Private Maven/Gradle mirror support: rendered at container start by the
# entrypoint from MAVEN_MIRROR_*/GRADLE_MIRROR_URL env vars.
COPY containers/strix-java-repos.sh /usr/local/bin/strix-java-repos
RUN chmod +x /usr/local/bin/strix-java-repos

# ---------------------------------------------------------------------------
# strix orchestrator
# ---------------------------------------------------------------------------
USER root

# Install the strix orchestrator into its own venv, isolated from the sandbox
# role's /app/.venv (caido-sdk-client, jwt_tool deps). uv and golang-go both
# ship in the base image; the wheel build compiles the Go TUI sidecar. Build
# caches are redirected to /tmp and dropped in the same layer so they never
# reach the image.
COPY pyproject.toml uv.lock README.md /opt/strix-src/
COPY strix/ /opt/strix-src/strix/
COPY scripts/tui_sidecar_hook.py /opt/strix-src/scripts/tui_sidecar_hook.py
RUN UV_CACHE_DIR=/tmp/uv-cache GOCACHE=/tmp/go-build GOMODCACHE=/tmp/go-mod \
    UV_PROJECT_ENVIRONMENT=/opt/strix/.venv \
    uv sync --frozen --no-dev --no-editable --directory /opt/strix-src \
 && rm -rf /opt/strix-src /tmp/uv-cache /tmp/go-build /tmp/go-mod \
 && ln -s /opt/strix/.venv/bin/strix /usr/local/bin/strix

COPY containers/strix-entrypoint.sh /usr/local/bin/strix-entrypoint.sh
RUN chmod +x /usr/local/bin/strix-entrypoint.sh

ENV PATH="/opt/strix/.venv/bin:${PATH}"

USER pentester

# Reports and run artifacts land under the working directory; /workspace is
# the conventional mount point to keep them.
WORKDIR /workspace

ENTRYPOINT ["strix-entrypoint.sh"]
